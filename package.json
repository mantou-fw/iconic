{
  "name": "iconic",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build-agent-pack.mjs && vite build",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:pack": "node scripts/desktop.mjs build --dir",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:build:mac": "node scripts/desktop.mjs build --platform=darwin --arch=arm64,x64",
    "desktop:build:windows": "node scripts/desktop.mjs build --platform=win32 --arch=x64",
    "mcp:serve": "node mcp/server.mjs",
    "mcp:check": "node scripts/mcp-check.mjs",
    "predev": "node scripts/build-agent-pack.mjs",
    "agents:pack": "node scripts/build-agent-pack.mjs",
    "agents:setup": "node scripts/setup-agent.mjs",
    "icons:build": "electron scripts/build-icons.mjs",
    "release:web": "node scripts/package-web.mjs"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1",
    "nitro": "^3.0.260903-beta",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
